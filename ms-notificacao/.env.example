# Copie para .env para rodar com `npm start` fora do Docker.
# Os valores abaixo já são os padrões e apontam para a infraestrutura do docker-compose.
PORT=3002
DATABASE_URL=postgres://notificacao:notificacao@localhost:5434/notificacoes
RABBITMQ_URL=amqp://comprefacil:comprefacil@localhost:5672
# SMTP do Mailpit (caixa de entrada em http://localhost:8025).
# Deixe SMTP_HOST vazio para só registrar as notificações no log.
SMTP_HOST=localhost
SMTP_PORT=1025
SMTP_USER=
SMTP_PASS=
EMAIL_REMETENTE="CompreFácil <nao-responda@comprefacil.com.br>"
LOG_LEVEL=info
