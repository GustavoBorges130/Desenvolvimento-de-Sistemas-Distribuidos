{
  "name": "ms-pagamento",
  "version": "1.0.0",
  "description": "Microsserviço de pagamentos da CompreFácil: recebe solicitações de transação por REST e AMQP e publica eventos no RabbitMQ.",
  "type": "module",
  "main": "src/server.js",
  "private": true,
  "scripts": {
    "start": "node --env-file-if-exists=.env src/server.js",
    "dev": "node --watch --env-file-if-exists=.env src/server.js",
    "test": "node --test"
  },
  "engines": {
    "node": ">=22"
  },
  "author": "Gustavo Borges",
  "license": "MIT",
  "dependencies": {
    "amqp-connection-manager": "^5.0.1",
    "amqplib": "^2.4.0",
    "express": "^5.3.0",
    "pg": "^8.23.1"
  }
}
