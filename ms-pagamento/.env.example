# Copie para .env para rodar com `npm start` fora do Docker.
# Os valores abaixo já são os padrões e apontam para a infraestrutura do docker-compose.
PORT=3001
DATABASE_URL=postgres://pagamento:pagamento@localhost:5433/pagamentos
RABBITMQ_URL=amqp://comprefacil:comprefacil@localhost:5672
# Tempo (ms) que o gateway de pagamento simulado leva para autorizar a cobrança
PROCESSAMENTO_DELAY_MS=3000
OUTBOX_INTERVALO_MS=1000
PROCESSAMENTO_PREFETCH=10
LOG_LEVEL=info
